#define SIP_FFT_REGBASE_OPTIMIZED 1
#include "vendor/regbase_small_impl.h"
#include "vendor/regbase_real_optimized_impl.h"
#include "params/fft_real_regbase_tiling.h"
#ifndef TILING_KEY_IS
#define TILING_KEY_IS(key) (TILING_KEY_VAR == (key))
#endif
extern "C" __global__ __vector__ void fft_real_regbase_optimized(__gm__ float* input, __gm__ float* coreTw,
                                                                 __gm__ float* realTw, __gm__ float* output,
                                                                 __gm__ uint8_t* workspace, __gm__ uint8_t* tiling)
{
    AscendC::InitSocState();
    const auto* t = reinterpret_cast<__gm__ FftRealRegBaseTiling*>(tiling);
    if constexpr (TILING_KEY_IS(1004104))
        real_optimized::Run<32, false, 1, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1004105))
        real_optimized::Run<32, false, 1, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1004108))
        real_optimized::Run<32, true, 1, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1004109))
        real_optimized::Run<32, true, 1, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1008200))
        real_optimized::Run<64, false, 1, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1008201))
        real_optimized::Run<64, false, 1, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1008204))
        real_optimized::Run<64, true, 1, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1008205))
        real_optimized::Run<64, true, 1, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1065584))
        real_optimized::Run<512, false, 6, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1065585))
        real_optimized::Run<512, false, 6, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1065588))
        real_optimized::Run<512, true, 6, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1065589))
        real_optimized::Run<512, true, 6, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1131088))
        real_optimized::Run<1024, false, 2, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1131089))
        real_optimized::Run<1024, false, 2, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1131092))
        real_optimized::Run<1024, true, 2, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1131093))
        real_optimized::Run<1024, true, 2, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1262176))
        real_optimized::Run<2048, false, 4, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1262177))
        real_optimized::Run<2048, false, 4, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1262180))
        real_optimized::Run<2048, true, 4, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1262181))
        real_optimized::Run<2048, true, 4, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1524312))
        real_optimized::Run<4096, false, 3, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1524313))
        real_optimized::Run<4096, false, 3, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1524316))
        real_optimized::Run<4096, true, 3, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1524317))
        real_optimized::Run<4096, true, 3, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(2048592))
        real_optimized::Run<8192, false, 2, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(2048593))
        real_optimized::Run<8192, false, 2, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(2048596))
        real_optimized::Run<8192, true, 2, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(2048597))
        real_optimized::Run<8192, true, 2, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1016400))
        real_optimized::Run<128, false, 2, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1016401))
        real_optimized::Run<128, false, 2, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1016404))
        real_optimized::Run<128, true, 2, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1016405))
        real_optimized::Run<128, true, 2, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1032816))
        real_optimized::Run<256, false, 6, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1032817))
        real_optimized::Run<256, false, 6, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1032820))
        real_optimized::Run<256, true, 6, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(1032821))
        real_optimized::Run<256, true, 6, true>(input, coreTw, realTw, output, t->batch);
    AscendC::PipeBarrier<PIPE_ALL>();
}
