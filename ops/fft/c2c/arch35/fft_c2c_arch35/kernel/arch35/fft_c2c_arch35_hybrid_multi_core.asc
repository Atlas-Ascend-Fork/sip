// 混合核:__mix__(1,2),AIC 逐矩阵 GEMM→owner AIV 的 UB 瓦片(行距 nDim=RoundUp8(2L)
// Fixpipe 行距 32B 对齐实证),AIV SIMT 排空回 GM(输出布局与 GEMM pass 一致
// 下游 TRANS+NFused 不变;将排空体换为融合核直吃 UB)。

#ifndef CATLASS_ARCH
#define CATLASS_ARCH 3510
#endif

#ifndef K_MAX_SHAPE_DIM
#define K_MAX_SHAPE_DIM 0
#endif

#include "kernel_operator.h"
#include "simt_api/asc_simt.h"

#include "catlass/arch/arch.hpp"
#include "catlass/arch/resource.hpp"
#include "catlass/catlass.hpp"
#include "catlass/gemm/block/block_mmad.hpp"
#include "catlass/gemm/dispatch_policy.hpp"
#include "catlass/gemm/gemm_type.hpp"
#include "catlass/gemm_coord.hpp"
#include "catlass/layout/layout.hpp"
#include "catlass/status.hpp"
#include "tla/layout.hpp"
#include "tla/tensor.hpp"

using namespace Catlass;
using namespace AscendC;

namespace {
// 与 tiling/fft_c2c_arch35_gemm_tiling.h 的 FftHybridTilingData 逐字段一致
struct HybridTilingData {
    int64_t batch;
    int32_t fftN;
    int32_t fftM;
    int32_t nDim;
    int32_t isInverse;
    uint32_t coreNum;
};

// 跨核旗标(mode 4 点对点路由,example/bench 直发先例同款)。mode 2 的阻塞等待在 MKI 发射的
// mix 任务下会毒化本核后续管线事件(AIC 死 Catlass intra-core 事件链、AIV 死 V 沉降)
// mode 4 免疫——终案。路由:AIC 置 0→AIV0、16→AIV1
// AIV1 置自动 +16 落 AIC 的 20;AIV 恒用自有 [0,16) 空间。
constexpr uint64_t SYNC_MODE = 4;
constexpr uint64_t SYNC_GEMM_DONE[2] = {0, 16}; // AIC 置 done[owner](路由到对应 AIV)
constexpr uint64_t SYNC_UB_FREE[2] = {4, 20};   // AIC 等 free[owner](AIV0→4,AIV1 自动 +16→20)
constexpr uint64_t AIV_WAIT_DONE = 0;           // AIV 恒等 id 0
constexpr uint64_t AIV_SET_FREE = 4;            // AIV 恒置 id 4(路由归位)

constexpr int32_t MTILE = 128; // GEMM L1 瓦片 M;每矩阵 fftN 行按此分块

using ArchTag = Arch::Ascend950;
// 手工编排链瓦片常量(承 BlockMmadTla 瓦片形状 L1<128,128,128>/L0<128,128,32>,序 M,N,K)
constexpr uint32_t HYB_L1_M = 128, HYB_L1_N = 128, HYB_L1_K = 128;
constexpr uint32_t HYB_L0_M = 128, HYB_L0_N = 128, HYB_L0_K = 32;
// 布局与张量类型:GM 行主→L1/L0 分形,别名照 PackedTileCopyTla 同款(选择器定具体分形)
using HybridTagL1A = typename Gemm::helper::L1ATypeSelector<Gemm::GemmType<float, layout::RowMajor>>::L1AType::Layout;
using HybridTagL1B = typename Gemm::helper::L1BTypeSelector<Gemm::GemmType<float, layout::RowMajor>>::L1BType::Layout;
using HybridTagL0A = typename Gemm::helper::L0ALayoutSelector<ArchTag>::Layout;
using HybridTensorL1A = tla::Tensor<AscendC::LocalTensor<float>, Catlass::detail::TagToLayout_t<float, HybridTagL1A>,
                                    tla::Coord<tla::_0, tla::_0>, AscendC::TPosition::A1>;
using HybridTensorL1B = tla::Tensor<AscendC::LocalTensor<float>, Catlass::detail::TagToLayout_t<float, HybridTagL1B>,
                                    tla::Coord<tla::_0, tla::_0>, AscendC::TPosition::A1>;
using HybridTensorL0A = tla::Tensor<AscendC::LocalTensor<float>, Catlass::detail::TagToLayout_t<float, HybridTagL0A>,
                                    tla::Coord<tla::_0, tla::_0>, AscendC::TPosition::A2>;
using HybridTensorL0B = tla::Tensor<AscendC::LocalTensor<float>, Catlass::detail::TagToLayout_t<float, layout::nZ>,
                                    tla::Coord<tla::_0, tla::_0>, AscendC::TPosition::B2>;
constexpr auto HYB_L1A_LAYOUT = tla::MakeLayout<float, HybridTagL1A>(tla::Int<HYB_L1_M>{}, tla::Int<HYB_L1_K>{});
constexpr auto HYB_L1B_LAYOUT = tla::MakeLayout<float, HybridTagL1B>(tla::Int<HYB_L1_K>{}, tla::Int<HYB_L1_N>{});

// ---------------------------------------------------------------------------
// L0C→UB 手工 fixpipe:FixpipeParamsArch3510 直调(C310 自动路径在 mix 发射下
// 静默故障,二分实证;subBlockId 路由到 owner AIV 的 UB bank)。
// 参数分类与设计说明见重构工作文件 test\sip-重构-配方与分解.md。
// ---------------------------------------------------------------------------
constexpr AscendC::FixpipeConfig HYB_FP_CFG = {AscendC::CO2Layout::ROW_MAJOR, true};

template <class TensorSrc, class TensorDst>
struct HybridCopyL0CToUbManual {
    // subBlockId=false→AIV0,true→AIV1(硬件把写重定向到对应 AIV 的 bank 同偏移)
    CATLASS_DEVICE void operator()(TensorDst const& dstTensor, TensorSrc const& srcTensor, bool subBlockId,
                                   uint8_t unitFlag)
    {
        (void)unitFlag; // 策略 enableUnitFlag=false,恒为 0
        // 运行时形状:dst=UB 行主瓦片 [m,n];src=L0C NZ 累加结果
        const uint32_t n = static_cast<uint32_t>(tla::get<1>(dstTensor.originShape()));
        const uint32_t nSize = (n + 7u) & ~7u; // 向上取 8:fixpipe 行宽 32B 粒度(fp32 8 列)
        const uint32_t mSize = static_cast<uint32_t>(tla::get<0>(dstTensor.originShape()));
        const uint32_t srcStride = tla::get<1, 1>(srcTensor.stride()) / tla::get<0, 0>(srcTensor.stride());
        const uint32_t dstStride = static_cast<uint32_t>(tla::get<0>(dstTensor.stride()));

        AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::ROW_MAJOR> fp;
        fp.nSize = nSize;                   // 行宽(含对齐)
        fp.mSize = mSize;                   // 本次搬运行数(尾块可小于瓦片 M)
        fp.srcStride = srcStride;           // L0C 内部 NZ 步距比(L0 瓦片配置决定)
        fp.dstStride = dstStride;           // UB 瓦片行距(=nDim,32B 对齐)
        fp.quantPre = QuantMode_t::NoQuant; // fp32 直写,无量化
        fp.subBlockId = subBlockId;
        // params(Nz2NdParams)保持缺省构造:与 Catlass C310 路径等效
        // (缺省 ndNum=1/srcNdMatrixStride=1/dstNdMatrixStride=1,直发冒烟已验证该组值)

        const auto dstOffset = dstTensor.layout()(dstTensor.coord());
        const auto srcOffset = srcTensor.layout()(srcTensor.coord());
        AscendC::Fixpipe<float, float, HYB_FP_CFG>(dstTensor.data()[dstOffset], srcTensor.data()[srcOffset], fp);
    }
};

// 平衡切分;CATLASS_DEVICE:__global__ __aicore__ 体不能调用普通 __host__ 内联函数(冒烟坑②)
CATLASS_DEVICE inline void CoreMatRange(int64_t total, uint32_t coreNum, uint32_t blockIdx, int64_t& start,
                                        int64_t& end)
{
    const int64_t per = total / coreNum;
    const int64_t rem = total % coreNum;
    start = static_cast<int64_t>(blockIdx) * per + (blockIdx < rem ? blockIdx : rem);
    end = start + per + (blockIdx < rem ? 1 : 0);
}

// ---------------------------------------------------------------------------
// 融合 N 变换体(example fft_simt_ops.h 同构逐字移植;500=20×25 两级寄存器融合
// 瓦片 [500,104] 列 FFT + 数字反转散射直写 GM——中间结果零 GM 往返)。
// 常量名保持 example 原名,宏体字节级一致;tw 表段偏移与仓内 NFused/核心构建器一致(ex89 布局)。
// ---------------------------------------------------------------------------
constexpr int32_t SIMT_THREADS = 256;
constexpr int32_t B2H = 50;                  // 每瓦片行有效复数列(=fftM)
constexpr int32_t ROW_STRIDE = 104;          // 瓦片行距(=nDim,Fixpipe dstStride)
constexpr int32_t TILE_FLOATS = 500 * 104;   // 52000
constexpr int32_t TW_FLOATS = 1040;          // 方向已选 tw 表浮点数
constexpr int32_t GM_ROW_FLOATS = 100;       // GM 输出行浮点(=2*fftM)
constexpr int32_t GM_MAT_FLOATS = 500 * 100; // 50000
constexpr int32_t R4_T1_OFF = 0;
constexpr int32_t R4_T2_OFF = 250;
constexpr int32_t R4_T3_OFF = 500;
constexpr int32_t TW3_OFF = 750;
constexpr int32_t TW4_OFF = 950;

// 对称 DFT-5 蝴蝶常数(ex89 R1)
constexpr float R5_C72 = 0.30901699437494745f;
constexpr float R5_C144 = -0.80901699494794734f;
constexpr float R5_S72 = 0.95105651629515357f;
constexpr float R5_S144 = 0.58778525229247314f;

// 对称 DFT-5 蝴蝶(ex89 R1);输出顺序 0,1,4,2,3
#define HYB_DFT5(x0r, x0i, x1r, x1i, x2r, x2i, x3r, x3i, x4r, x4i)            \
    do {                                                                      \
        const float s1r = (x1r) + (x4r), s1i = (x1i) + (x4i);                 \
        const float s2r = (x2r) + (x3r), s2i = (x2i) + (x3i);                 \
        const float d1r = (x1r) - (x4r), d1i = (x1i) - (x4i);                 \
        const float d2r = (x2r) - (x3r), d2i = (x2i) - (x3i);                 \
        const float A1 = R5_C72 * s1r + R5_C144 * s2r;                        \
        const float B1 = R5_C72 * s1i + R5_C144 * s2i;                        \
        const float D1 = R5_S72 * d1r + R5_S144 * d2r;                        \
        const float E1 = R5_S72 * d1i + R5_S144 * d2i;                        \
        const float A2 = R5_C144 * s1r + R5_C72 * s2r;                        \
        const float B2 = R5_C144 * s1i + R5_C72 * s2i;                        \
        const float D2 = R5_S144 * d1r - R5_S72 * d2r;                        \
        const float E2 = R5_S144 * d1i - R5_S72 * d2i;                        \
        const float t0r = (x0r) + s1r + s2r, t0i = (x0i) + s1i + s2i;         \
        const float t1r = (x0r) + A1 + sgn * E1, t1i = (x0i) + B1 - sgn * D1; \
        const float t4r = (x0r) + A1 - sgn * E1, t4i = (x0i) + B1 + sgn * D1; \
        const float t2r = (x0r) + A2 + sgn * E2, t2i = (x0i) + B2 - sgn * D2; \
        const float t3r = (x0r) + A2 - sgn * E2, t3i = (x0i) + B2 + sgn * D2; \
        (x0r) = t0r;                                                          \
        (x0i) = t0i;                                                          \
        (x1r) = t1r;                                                          \
        (x1i) = t1i;                                                          \
        (x4r) = t4r;                                                          \
        (x4i) = t4i;                                                          \
        (x2r) = t2r;                                                          \
        (x2i) = t2i;                                                          \
        (x3r) = t3r;                                                          \
        (x3i) = t3i;                                                          \
    } while (0)

// radix-4 DIF(3 个 twiddle)
#define HYB_R4(x0r, x0i, x1r, x1i, x2r, x2i, x3r, x3i, w1r, w1i, w2r, w2i, w3r, w3i)  \
    do {                                                                              \
        const float a0r = (x0r) + (x2r), a0i = (x0i) + (x2i);                         \
        const float a1r = (x0r) - (x2r), a1i = (x0i) - (x2i);                         \
        const float a2r = (x1r) + (x3r), a2i = (x1i) + (x3i);                         \
        const float a3r = (x1r) - (x3r), a3i = (x1i) - (x3i);                         \
        const float y0r = a0r + a2r, y0i = a0i + a2i;                                 \
        const float b1r = a1r + sgn * a3i, b1i = a1i - sgn * a3r;                     \
        const float b3r = a1r - sgn * a3i, b3i = a1i + sgn * a3r;                     \
        const float b2r = a0r - a2r, b2i = a0i - a2i;                                 \
        const float y1r = b1r * (w1r) - b1i * (w1i), y1i = b1r * (w1i) + b1i * (w1r); \
        const float y2r = b2r * (w2r) - b2i * (w2i), y2i = b2r * (w2i) + b2i * (w2r); \
        const float y3r = b3r * (w3r) - b3i * (w3i), y3i = b3r * (w3i) + b3i * (w3r); \
        (x0r) = y0r;                                                                  \
        (x0i) = y0i;                                                                  \
        (x1r) = y1r;                                                                  \
        (x1i) = y1i;                                                                  \
        (x2r) = y2r;                                                                  \
        (x2i) = y2i;                                                                  \
        (x3r) = y3r;                                                                  \
        (x3i) = y3i;                                                                  \
    } while (0)

#define HYB_TWMUL(cr, ci, tr, ti)                   \
    do {                                            \
        const float zr = (cr) * (tr) - (ci) * (ti); \
        const float zi = (cr) * (ti) + (ci) * (tr); \
        (cr) = zr;                                  \
        (ci) = zi;                                  \
    } while (0)

#define HYB_DIGREV20(f) ((f) / 5 + 4 * ((f) % 5))

// 级 A:radix-20(r4 D=125 融 r5 D=25);25 组 × 50 列
#define HYB_STAGE20                                                                                     \
    do {                                                                                                \
        const uint32_t total = 25 * static_cast<uint32_t>(B2H);                                         \
        const uint32_t step25 = 25 * static_cast<uint32_t>(ROW_STRIDE);                                 \
        const uint32_t iters = (total + SIMT_THREADS - 1) / SIMT_THREADS;                               \
        for (uint32_t it = 0; it < iters; ++it) {                                                       \
            const uint32_t e = it * SIMT_THREADS + threadIdx.x;                                         \
            if (e >= total)                                                                             \
                continue;                                                                               \
            const uint32_t jj = e % static_cast<uint32_t>(B2H);                                         \
            const uint32_t g = e / static_cast<uint32_t>(B2H);                                          \
            const uint32_t base = g * static_cast<uint32_t>(ROW_STRIDE) + 2 * jj;                       \
            float x0r = data[base];                                                                     \
            float x0i = data[base + 1];                                                                 \
            float x1r = data[base + step25];                                                            \
            float x1i = data[base + step25 + 1];                                                        \
            float x2r = data[base + 2 * step25];                                                        \
            float x2i = data[base + 2 * step25 + 1];                                                    \
            float x3r = data[base + 3 * step25];                                                        \
            float x3i = data[base + 3 * step25 + 1];                                                    \
            float x4r = data[base + 4 * step25];                                                        \
            float x4i = data[base + 4 * step25 + 1];                                                    \
            float x5r = data[base + 5 * step25];                                                        \
            float x5i = data[base + 5 * step25 + 1];                                                    \
            float x6r = data[base + 6 * step25];                                                        \
            float x6i = data[base + 6 * step25 + 1];                                                    \
            float x7r = data[base + 7 * step25];                                                        \
            float x7i = data[base + 7 * step25 + 1];                                                    \
            float x8r = data[base + 8 * step25];                                                        \
            float x8i = data[base + 8 * step25 + 1];                                                    \
            float x9r = data[base + 9 * step25];                                                        \
            float x9i = data[base + 9 * step25 + 1];                                                    \
            float x10r = data[base + 10 * step25];                                                      \
            float x10i = data[base + 10 * step25 + 1];                                                  \
            float x11r = data[base + 11 * step25];                                                      \
            float x11i = data[base + 11 * step25 + 1];                                                  \
            float x12r = data[base + 12 * step25];                                                      \
            float x12i = data[base + 12 * step25 + 1];                                                  \
            float x13r = data[base + 13 * step25];                                                      \
            float x13i = data[base + 13 * step25 + 1];                                                  \
            float x14r = data[base + 14 * step25];                                                      \
            float x14i = data[base + 14 * step25 + 1];                                                  \
            float x15r = data[base + 15 * step25];                                                      \
            float x15i = data[base + 15 * step25 + 1];                                                  \
            float x16r = data[base + 16 * step25];                                                      \
            float x16i = data[base + 16 * step25 + 1];                                                  \
            float x17r = data[base + 17 * step25];                                                      \
            float x17i = data[base + 17 * step25 + 1];                                                  \
            float x18r = data[base + 18 * step25];                                                      \
            float x18i = data[base + 18 * step25 + 1];                                                  \
            float x19r = data[base + 19 * step25];                                                      \
            float x19i = data[base + 19 * step25 + 1];                                                  \
            {                                                                                           \
                const uint32_t j0 = g + 25 * 0;                                                         \
                float w1r = tw[(R4_T1_OFF) + 2 * j0], w1i = tw[(R4_T1_OFF) + 2 * j0 + 1];               \
                float w2r = tw[(R4_T2_OFF) + 2 * j0], w2i = tw[(R4_T2_OFF) + 2 * j0 + 1];               \
                float w3r = tw[(R4_T3_OFF) + 2 * j0], w3i = tw[(R4_T3_OFF) + 2 * j0 + 1];               \
                HYB_R4(x0r, x0i, x5r, x5i, x10r, x10i, x15r, x15i, w1r, w1i, w2r, w2i, w3r, w3i);       \
            }                                                                                           \
            {                                                                                           \
                const uint32_t j1 = g + 25 * 1;                                                         \
                float w1r = tw[(R4_T1_OFF) + 2 * j1], w1i = tw[(R4_T1_OFF) + 2 * j1 + 1];               \
                float w2r = tw[(R4_T2_OFF) + 2 * j1], w2i = tw[(R4_T2_OFF) + 2 * j1 + 1];               \
                float w3r = tw[(R4_T3_OFF) + 2 * j1], w3i = tw[(R4_T3_OFF) + 2 * j1 + 1];               \
                HYB_R4(x1r, x1i, x6r, x6i, x11r, x11i, x16r, x16i, w1r, w1i, w2r, w2i, w3r, w3i);       \
            }                                                                                           \
            {                                                                                           \
                const uint32_t j2 = g + 25 * 2;                                                         \
                float w1r = tw[(R4_T1_OFF) + 2 * j2], w1i = tw[(R4_T1_OFF) + 2 * j2 + 1];               \
                float w2r = tw[(R4_T2_OFF) + 2 * j2], w2i = tw[(R4_T2_OFF) + 2 * j2 + 1];               \
                float w3r = tw[(R4_T3_OFF) + 2 * j2], w3i = tw[(R4_T3_OFF) + 2 * j2 + 1];               \
                HYB_R4(x2r, x2i, x7r, x7i, x12r, x12i, x17r, x17i, w1r, w1i, w2r, w2i, w3r, w3i);       \
            }                                                                                           \
            {                                                                                           \
                const uint32_t j3 = g + 25 * 3;                                                         \
                float w1r = tw[(R4_T1_OFF) + 2 * j3], w1i = tw[(R4_T1_OFF) + 2 * j3 + 1];               \
                float w2r = tw[(R4_T2_OFF) + 2 * j3], w2i = tw[(R4_T2_OFF) + 2 * j3 + 1];               \
                float w3r = tw[(R4_T3_OFF) + 2 * j3], w3i = tw[(R4_T3_OFF) + 2 * j3 + 1];               \
                HYB_R4(x3r, x3i, x8r, x8i, x13r, x13i, x18r, x18i, w1r, w1i, w2r, w2i, w3r, w3i);       \
            }                                                                                           \
            {                                                                                           \
                const uint32_t j4 = g + 25 * 4;                                                         \
                float w1r = tw[(R4_T1_OFF) + 2 * j4], w1i = tw[(R4_T1_OFF) + 2 * j4 + 1];               \
                float w2r = tw[(R4_T2_OFF) + 2 * j4], w2i = tw[(R4_T2_OFF) + 2 * j4 + 1];               \
                float w3r = tw[(R4_T3_OFF) + 2 * j4], w3i = tw[(R4_T3_OFF) + 2 * j4 + 1];               \
                HYB_R4(x4r, x4i, x9r, x9i, x14r, x14i, x19r, x19i, w1r, w1i, w2r, w2i, w3r, w3i);       \
            }                                                                                           \
            {                                                                                           \
                float t1r = tw[(TW3_OFF) + 2 * (g * 4 + 0)], t1i = tw[(TW3_OFF) + 2 * (g * 4 + 0) + 1]; \
                float t2r = tw[(TW3_OFF) + 2 * (g * 4 + 1)], t2i = tw[(TW3_OFF) + 2 * (g * 4 + 1) + 1]; \
                float t3r = tw[(TW3_OFF) + 2 * (g * 4 + 2)], t3i = tw[(TW3_OFF) + 2 * (g * 4 + 2) + 1]; \
                float t4r = tw[(TW3_OFF) + 2 * (g * 4 + 3)], t4i = tw[(TW3_OFF) + 2 * (g * 4 + 3) + 1]; \
                HYB_DFT5(x0r, x0i, x1r, x1i, x2r, x2i, x3r, x3i, x4r, x4i);                             \
                HYB_TWMUL(x1r, x1i, t1r, t1i);                                                          \
                HYB_TWMUL(x4r, x4i, t4r, t4i);                                                          \
                HYB_TWMUL(x2r, x2i, t2r, t2i);                                                          \
                HYB_TWMUL(x3r, x3i, t3r, t3i);                                                          \
            }                                                                                           \
            {                                                                                           \
                float t1r = tw[(TW3_OFF) + 2 * (g * 4 + 0)], t1i = tw[(TW3_OFF) + 2 * (g * 4 + 0) + 1]; \
                float t2r = tw[(TW3_OFF) + 2 * (g * 4 + 1)], t2i = tw[(TW3_OFF) + 2 * (g * 4 + 1) + 1]; \
                float t3r = tw[(TW3_OFF) + 2 * (g * 4 + 2)], t3i = tw[(TW3_OFF) + 2 * (g * 4 + 2) + 1]; \
                float t4r = tw[(TW3_OFF) + 2 * (g * 4 + 3)], t4i = tw[(TW3_OFF) + 2 * (g * 4 + 3) + 1]; \
                HYB_DFT5(x5r, x5i, x6r, x6i, x7r, x7i, x8r, x8i, x9r, x9i);                             \
                HYB_TWMUL(x6r, x6i, t1r, t1i);                                                          \
                HYB_TWMUL(x9r, x9i, t4r, t4i);                                                          \
                HYB_TWMUL(x7r, x7i, t2r, t2i);                                                          \
                HYB_TWMUL(x8r, x8i, t3r, t3i);                                                          \
            }                                                                                           \
            {                                                                                           \
                float t1r = tw[(TW3_OFF) + 2 * (g * 4 + 0)], t1i = tw[(TW3_OFF) + 2 * (g * 4 + 0) + 1]; \
                float t2r = tw[(TW3_OFF) + 2 * (g * 4 + 1)], t2i = tw[(TW3_OFF) + 2 * (g * 4 + 1) + 1]; \
                float t3r = tw[(TW3_OFF) + 2 * (g * 4 + 2)], t3i = tw[(TW3_OFF) + 2 * (g * 4 + 2) + 1]; \
                float t4r = tw[(TW3_OFF) + 2 * (g * 4 + 3)], t4i = tw[(TW3_OFF) + 2 * (g * 4 + 3) + 1]; \
                HYB_DFT5(x10r, x10i, x11r, x11i, x12r, x12i, x13r, x13i, x14r, x14i);                   \
                HYB_TWMUL(x11r, x11i, t1r, t1i);                                                        \
                HYB_TWMUL(x14r, x14i, t4r, t4i);                                                        \
                HYB_TWMUL(x12r, x12i, t2r, t2i);                                                        \
                HYB_TWMUL(x13r, x13i, t3r, t3i);                                                        \
            }                                                                                           \
            {                                                                                           \
                float t1r = tw[(TW3_OFF) + 2 * (g * 4 + 0)], t1i = tw[(TW3_OFF) + 2 * (g * 4 + 0) + 1]; \
                float t2r = tw[(TW3_OFF) + 2 * (g * 4 + 1)], t2i = tw[(TW3_OFF) + 2 * (g * 4 + 1) + 1]; \
                float t3r = tw[(TW3_OFF) + 2 * (g * 4 + 2)], t3i = tw[(TW3_OFF) + 2 * (g * 4 + 2) + 1]; \
                float t4r = tw[(TW3_OFF) + 2 * (g * 4 + 3)], t4i = tw[(TW3_OFF) + 2 * (g * 4 + 3) + 1]; \
                HYB_DFT5(x15r, x15i, x16r, x16i, x17r, x17i, x18r, x18i, x19r, x19i);                   \
                HYB_TWMUL(x16r, x16i, t1r, t1i);                                                        \
                HYB_TWMUL(x19r, x19i, t4r, t4i);                                                        \
                HYB_TWMUL(x17r, x17i, t2r, t2i);                                                        \
                HYB_TWMUL(x18r, x18i, t3r, t3i);                                                        \
            }                                                                                           \
            data[base] = x0r;                                                                           \
            data[base + 1] = x0i;                                                                       \
            data[base + step25] = x1r;                                                                  \
            data[base + step25 + 1] = x1i;                                                              \
            data[base + 2 * step25] = x2r;                                                              \
            data[base + 2 * step25 + 1] = x2i;                                                          \
            data[base + 3 * step25] = x3r;                                                              \
            data[base + 3 * step25 + 1] = x3i;                                                          \
            data[base + 4 * step25] = x4r;                                                              \
            data[base + 4 * step25 + 1] = x4i;                                                          \
            data[base + 5 * step25] = x5r;                                                              \
            data[base + 5 * step25 + 1] = x5i;                                                          \
            data[base + 6 * step25] = x6r;                                                              \
            data[base + 6 * step25 + 1] = x6i;                                                          \
            data[base + 7 * step25] = x7r;                                                              \
            data[base + 7 * step25 + 1] = x7i;                                                          \
            data[base + 8 * step25] = x8r;                                                              \
            data[base + 8 * step25 + 1] = x8i;                                                          \
            data[base + 9 * step25] = x9r;                                                              \
            data[base + 9 * step25 + 1] = x9i;                                                          \
            data[base + 10 * step25] = x10r;                                                            \
            data[base + 10 * step25 + 1] = x10i;                                                        \
            data[base + 11 * step25] = x11r;                                                            \
            data[base + 11 * step25 + 1] = x11i;                                                        \
            data[base + 12 * step25] = x12r;                                                            \
            data[base + 12 * step25 + 1] = x12i;                                                        \
            data[base + 13 * step25] = x13r;                                                            \
            data[base + 13 * step25 + 1] = x13i;                                                        \
            data[base + 14 * step25] = x14r;                                                            \
            data[base + 14 * step25 + 1] = x14i;                                                        \
            data[base + 15 * step25] = x15r;                                                            \
            data[base + 15 * step25 + 1] = x15i;                                                        \
            data[base + 16 * step25] = x16r;                                                            \
            data[base + 16 * step25 + 1] = x16i;                                                        \
            data[base + 17 * step25] = x17r;                                                            \
            data[base + 17 * step25 + 1] = x17i;                                                        \
            data[base + 18 * step25] = x18r;                                                            \
            data[base + 18 * step25 + 1] = x18i;                                                        \
            data[base + 19 * step25] = x19r;                                                            \
            data[base + 19 * step25 + 1] = x19i;                                                        \
        }                                                                                               \
    } while (0)

// 级 B:radix-25(r5 D=5 融 r5 D=1)+ 数字反转散射
#define HYB_STAGE25_SCATTER                                                                             \
    do {                                                                                                \
        const uint32_t total = 20 * static_cast<uint32_t>(B2H);                                         \
        const uint32_t step = static_cast<uint32_t>(ROW_STRIDE);                                        \
        const uint32_t dk3 = 20 * static_cast<uint32_t>(GM_ROW_FLOATS) / 2;                             \
        const uint32_t dk4 = 100 * static_cast<uint32_t>(GM_ROW_FLOATS) / 2;                            \
        const uint32_t iters = (total + SIMT_THREADS - 1) / SIMT_THREADS;                               \
        for (uint32_t it = 0; it < iters; ++it) {                                                       \
            const uint32_t e = it * SIMT_THREADS + threadIdx.x;                                         \
            if (e >= total)                                                                             \
                continue;                                                                               \
            const uint32_t jj = e % static_cast<uint32_t>(B2H);                                         \
            const uint32_t fp = e / static_cast<uint32_t>(B2H);                                         \
            const uint32_t base = (25 * fp) * step + 2 * jj;                                            \
            float x0r = data[base];                                                                     \
            float x0i = data[base + 1];                                                                 \
            float x1r = data[base + step];                                                              \
            float x1i = data[base + step + 1];                                                          \
            float x2r = data[base + 2 * step];                                                          \
            float x2i = data[base + 2 * step + 1];                                                      \
            float x3r = data[base + 3 * step];                                                          \
            float x3i = data[base + 3 * step + 1];                                                      \
            float x4r = data[base + 4 * step];                                                          \
            float x4i = data[base + 4 * step + 1];                                                      \
            float x5r = data[base + 5 * step];                                                          \
            float x5i = data[base + 5 * step + 1];                                                      \
            float x6r = data[base + 6 * step];                                                          \
            float x6i = data[base + 6 * step + 1];                                                      \
            float x7r = data[base + 7 * step];                                                          \
            float x7i = data[base + 7 * step + 1];                                                      \
            float x8r = data[base + 8 * step];                                                          \
            float x8i = data[base + 8 * step + 1];                                                      \
            float x9r = data[base + 9 * step];                                                          \
            float x9i = data[base + 9 * step + 1];                                                      \
            float x10r = data[base + 10 * step];                                                        \
            float x10i = data[base + 10 * step + 1];                                                    \
            float x11r = data[base + 11 * step];                                                        \
            float x11i = data[base + 11 * step + 1];                                                    \
            float x12r = data[base + 12 * step];                                                        \
            float x12i = data[base + 12 * step + 1];                                                    \
            float x13r = data[base + 13 * step];                                                        \
            float x13i = data[base + 13 * step + 1];                                                    \
            float x14r = data[base + 14 * step];                                                        \
            float x14i = data[base + 14 * step + 1];                                                    \
            float x15r = data[base + 15 * step];                                                        \
            float x15i = data[base + 15 * step + 1];                                                    \
            float x16r = data[base + 16 * step];                                                        \
            float x16i = data[base + 16 * step + 1];                                                    \
            float x17r = data[base + 17 * step];                                                        \
            float x17i = data[base + 17 * step + 1];                                                    \
            float x18r = data[base + 18 * step];                                                        \
            float x18i = data[base + 18 * step + 1];                                                    \
            float x19r = data[base + 19 * step];                                                        \
            float x19i = data[base + 19 * step + 1];                                                    \
            float x20r = data[base + 20 * step];                                                        \
            float x20i = data[base + 20 * step + 1];                                                    \
            float x21r = data[base + 21 * step];                                                        \
            float x21i = data[base + 21 * step + 1];                                                    \
            float x22r = data[base + 22 * step];                                                        \
            float x22i = data[base + 22 * step + 1];                                                    \
            float x23r = data[base + 23 * step];                                                        \
            float x23i = data[base + 23 * step + 1];                                                    \
            float x24r = data[base + 24 * step];                                                        \
            float x24i = data[base + 24 * step + 1];                                                    \
            {                                                                                           \
                float t1r = tw[(TW4_OFF) + 2 * (0 * 4 + 0)], t1i = tw[(TW4_OFF) + 2 * (0 * 4 + 0) + 1]; \
                float t2r = tw[(TW4_OFF) + 2 * (0 * 4 + 1)], t2i = tw[(TW4_OFF) + 2 * (0 * 4 + 1) + 1]; \
                float t3r = tw[(TW4_OFF) + 2 * (0 * 4 + 2)], t3i = tw[(TW4_OFF) + 2 * (0 * 4 + 2) + 1]; \
                float t4r = tw[(TW4_OFF) + 2 * (0 * 4 + 3)], t4i = tw[(TW4_OFF) + 2 * (0 * 4 + 3) + 1]; \
                HYB_DFT5(x0r, x0i, x5r, x5i, x10r, x10i, x15r, x15i, x20r, x20i);                       \
                HYB_TWMUL(x5r, x5i, t1r, t1i);                                                          \
                HYB_TWMUL(x20r, x20i, t4r, t4i);                                                        \
                HYB_TWMUL(x10r, x10i, t2r, t2i);                                                        \
                HYB_TWMUL(x15r, x15i, t3r, t3i);                                                        \
            }                                                                                           \
            {                                                                                           \
                float t1r = tw[(TW4_OFF) + 2 * (1 * 4 + 0)], t1i = tw[(TW4_OFF) + 2 * (1 * 4 + 0) + 1]; \
                float t2r = tw[(TW4_OFF) + 2 * (1 * 4 + 1)], t2i = tw[(TW4_OFF) + 2 * (1 * 4 + 1) + 1]; \
                float t3r = tw[(TW4_OFF) + 2 * (1 * 4 + 2)], t3i = tw[(TW4_OFF) + 2 * (1 * 4 + 2) + 1]; \
                float t4r = tw[(TW4_OFF) + 2 * (1 * 4 + 3)], t4i = tw[(TW4_OFF) + 2 * (1 * 4 + 3) + 1]; \
                HYB_DFT5(x1r, x1i, x6r, x6i, x11r, x11i, x16r, x16i, x21r, x21i);                       \
                HYB_TWMUL(x6r, x6i, t1r, t1i);                                                          \
                HYB_TWMUL(x21r, x21i, t4r, t4i);                                                        \
                HYB_TWMUL(x11r, x11i, t2r, t2i);                                                        \
                HYB_TWMUL(x16r, x16i, t3r, t3i);                                                        \
            }                                                                                           \
            {                                                                                           \
                float t1r = tw[(TW4_OFF) + 2 * (2 * 4 + 0)], t1i = tw[(TW4_OFF) + 2 * (2 * 4 + 0) + 1]; \
                float t2r = tw[(TW4_OFF) + 2 * (2 * 4 + 1)], t2i = tw[(TW4_OFF) + 2 * (2 * 4 + 1) + 1]; \
                float t3r = tw[(TW4_OFF) + 2 * (2 * 4 + 2)], t3i = tw[(TW4_OFF) + 2 * (2 * 4 + 2) + 1]; \
                float t4r = tw[(TW4_OFF) + 2 * (2 * 4 + 3)], t4i = tw[(TW4_OFF) + 2 * (2 * 4 + 3) + 1]; \
                HYB_DFT5(x2r, x2i, x7r, x7i, x12r, x12i, x17r, x17i, x22r, x22i);                       \
                HYB_TWMUL(x7r, x7i, t1r, t1i);                                                          \
                HYB_TWMUL(x22r, x22i, t4r, t4i);                                                        \
                HYB_TWMUL(x12r, x12i, t2r, t2i);                                                        \
                HYB_TWMUL(x17r, x17i, t3r, t3i);                                                        \
            }                                                                                           \
            {                                                                                           \
                float t1r = tw[(TW4_OFF) + 2 * (3 * 4 + 0)], t1i = tw[(TW4_OFF) + 2 * (3 * 4 + 0) + 1]; \
                float t2r = tw[(TW4_OFF) + 2 * (3 * 4 + 1)], t2i = tw[(TW4_OFF) + 2 * (3 * 4 + 1) + 1]; \
                float t3r = tw[(TW4_OFF) + 2 * (3 * 4 + 2)], t3i = tw[(TW4_OFF) + 2 * (3 * 4 + 2) + 1]; \
                float t4r = tw[(TW4_OFF) + 2 * (3 * 4 + 3)], t4i = tw[(TW4_OFF) + 2 * (3 * 4 + 3) + 1]; \
                HYB_DFT5(x3r, x3i, x8r, x8i, x13r, x13i, x18r, x18i, x23r, x23i);                       \
                HYB_TWMUL(x8r, x8i, t1r, t1i);                                                          \
                HYB_TWMUL(x23r, x23i, t4r, t4i);                                                        \
                HYB_TWMUL(x13r, x13i, t2r, t2i);                                                        \
                HYB_TWMUL(x18r, x18i, t3r, t3i);                                                        \
            }                                                                                           \
            {                                                                                           \
                float t1r = tw[(TW4_OFF) + 2 * (4 * 4 + 0)], t1i = tw[(TW4_OFF) + 2 * (4 * 4 + 0) + 1]; \
                float t2r = tw[(TW4_OFF) + 2 * (4 * 4 + 1)], t2i = tw[(TW4_OFF) + 2 * (4 * 4 + 1) + 1]; \
                float t3r = tw[(TW4_OFF) + 2 * (4 * 4 + 2)], t3i = tw[(TW4_OFF) + 2 * (4 * 4 + 2) + 1]; \
                float t4r = tw[(TW4_OFF) + 2 * (4 * 4 + 3)], t4i = tw[(TW4_OFF) + 2 * (4 * 4 + 3) + 1]; \
                HYB_DFT5(x4r, x4i, x9r, x9i, x14r, x14i, x19r, x19i, x24r, x24i);                       \
                HYB_TWMUL(x9r, x9i, t1r, t1i);                                                          \
                HYB_TWMUL(x24r, x24i, t4r, t4i);                                                        \
                HYB_TWMUL(x14r, x14i, t2r, t2i);                                                        \
                HYB_TWMUL(x19r, x19i, t3r, t3i);                                                        \
            }                                                                                           \
            HYB_DFT5(x0r, x0i, x1r, x1i, x2r, x2i, x3r, x3i, x4r, x4i);                                 \
            HYB_DFT5(x5r, x5i, x6r, x6i, x7r, x7i, x8r, x8i, x9r, x9i);                                 \
            HYB_DFT5(x10r, x10i, x11r, x11i, x12r, x12i, x13r, x13i, x14r, x14i);                       \
            HYB_DFT5(x15r, x15i, x16r, x16i, x17r, x17i, x18r, x18i, x19r, x19i);                       \
            HYB_DFT5(x20r, x20i, x21r, x21i, x22r, x22i, x23r, x23i, x24r, x24i);                       \
            const uint32_t fr = HYB_DIGREV20(fp);                                                       \
            const uint32_t gmBase = fr * static_cast<uint32_t>(GM_ROW_FLOATS) + 2 * jj;                 \
            __gm__ float2* d2 = (__gm__ float2*)(gmOut + gmBase);                                       \
            d2[0] = make_float2(x0r, x0i);                                                              \
            d2[dk4] = make_float2(x1r, x1i);                                                            \
            d2[2 * dk4] = make_float2(x2r, x2i);                                                        \
            d2[3 * dk4] = make_float2(x3r, x3i);                                                        \
            d2[4 * dk4] = make_float2(x4r, x4i);                                                        \
            d2[dk3] = make_float2(x5r, x5i);                                                            \
            d2[dk3 + dk4] = make_float2(x6r, x6i);                                                      \
            d2[dk3 + 2 * dk4] = make_float2(x7r, x7i);                                                  \
            d2[dk3 + 3 * dk4] = make_float2(x8r, x8i);                                                  \
            d2[dk3 + 4 * dk4] = make_float2(x9r, x9i);                                                  \
            d2[2 * dk3] = make_float2(x10r, x10i);                                                      \
            d2[2 * dk3 + dk4] = make_float2(x11r, x11i);                                                \
            d2[2 * dk3 + 2 * dk4] = make_float2(x12r, x12i);                                            \
            d2[2 * dk3 + 3 * dk4] = make_float2(x13r, x13i);                                            \
            d2[2 * dk3 + 4 * dk4] = make_float2(x14r, x14i);                                            \
            d2[3 * dk3] = make_float2(x15r, x15i);                                                      \
            d2[3 * dk3 + dk4] = make_float2(x16r, x16i);                                                \
            d2[3 * dk3 + 2 * dk4] = make_float2(x17r, x17i);                                            \
            d2[3 * dk3 + 3 * dk4] = make_float2(x18r, x18i);                                            \
            d2[3 * dk3 + 4 * dk4] = make_float2(x19r, x19i);                                            \
            d2[4 * dk3] = make_float2(x20r, x20i);                                                      \
            d2[4 * dk3 + dk4] = make_float2(x21r, x21i);                                                \
            d2[4 * dk3 + 2 * dk4] = make_float2(x22r, x22i);                                            \
            d2[4 * dk3 + 3 * dk4] = make_float2(x23r, x23i);                                            \
            d2[4 * dk3 + 4 * dk4] = make_float2(x24r, x24i);                                            \
        }                                                                                               \
    } while (0)

// 级 A/级 B 合并单 vf 函数:两级间用显式栅栏,每矩阵仅 1 次 vf 调用
// (背靠背双 vf call 有排空税,合并实测收约 0.08ms/向)
// 合并结构对任意两级蝴蝶通用,不锁特化形状;后续泛化重写时按新蝴蝶
// 寄存器预算权衡是否保持合并。
// tw 由调用方传入 UB 指针(VECCALC 静态视窗 offset 212096;VECOUT 静态
// 映射 208000B 以上不可读,原 GM 直读路径已废除)
template <int32_t SGN>
__simt_vf__ __launch_bounds__(SIMT_THREADS) inline void hybrid_stage_ab_impl(__ubuf__ float* data, __ubuf__ float* tw,
                                                                             __gm__ float* gmOut)
{
    constexpr float sgn = static_cast<float>(SGN);
    HYB_STAGE20;
    asc_syncthreads();
    HYB_STAGE25_SCATTER;
}

#undef HYB_DFT5
#undef HYB_R4
#undef HYB_TWMUL
#undef HYB_DIGREV20
#undef HYB_STAGE20
#undef HYB_STAGE25_SCATTER
} // namespace

extern "C" __global__ __mix__(1, 2) void fft_c2c_arch35_hybrid_multi_core(__gm__ float* input, __gm__ float* wGm,
                                                                          __gm__ float* output, __gm__ uint8_t* tiling)
{
    AscendC::InitSocState();
    __gm__ HybridTilingData* td = (__gm__ HybridTilingData*)tiling;

    // 块号:AIC=GetBlockIdx;AIV=GetBlockIdx>>1(1:2 配对交错惯例)
    uint32_t blockIdx;
    if ASCEND_IS_AIC {
        blockIdx = AscendC::GetBlockIdx();
    } else {
        blockIdx = AscendC::GetBlockIdx() >> 1;
    }
    if (blockIdx >= td->coreNum) {
        return;
    }

    const int64_t batch = td->batch;
    const int64_t fftN = td->fftN;
    const int64_t fftM = td->fftM;
    const int64_t nDim = td->nDim;
    const int64_t kDim = fftM * 2;

    int64_t matStart = 0;
    int64_t matEnd = 0;
    CoreMatRange(batch, td->coreNum, blockIdx, matStart, matEnd);
    const int64_t matCount = matEnd - matStart;

    if ASCEND_IS_AIC {
        // AIC:逐矩阵 GEMM→owner AIV 的 UB bank;li≥2 先等 bank 释放(乒乓周期 2)。
        // UB 目的地址用静态 VECOUT 偏移 0(实测偏移非 0 时 fixpipe 路由故障):MKI 发射下
        // 动态窗口不可依赖,静态区始终映射,packed32 的 AIC 同样走静态 VECOUT
        // subBlockId 路由把写重定向到 owner AIV 的 bank 同偏移。tw 表驻瓦片上方 4KB
        // 缓冲带之后(fixpipe 尾部越界实测会踩紧邻区)
        // 手工编排缓冲与事件号(staging 对齐原 BlockMmadTla 策略:L1A×2、W 常驻 L1B×1、
        // L0A×2、L0B×2、L0C×2,跨块重叠 GM→L1 装载与 Mmad/Fixpipe)
        constexpr uint32_t L1A_BYTES = HYB_L1_M * HYB_L1_K * sizeof(float);
        constexpr uint32_t L1B_BYTES = HYB_L1_K * HYB_L1_N * sizeof(float);
        constexpr uint32_t L0A_BYTES = HYB_L0_M * HYB_L0_K * sizeof(float);
        constexpr uint32_t L0B_BYTES = HYB_L0_K * HYB_L0_N * sizeof(float);
        constexpr uint32_t L0C_BYTES = HYB_L1_M * HYB_L1_N * sizeof(float);
        // L1 是单块内存,A1/B1 仅为角色标签:按字节偏移分区(A 区 2 级 0/64KB,W 区 128KB 起)
        AscendC::LocalTensor<float> l1aList[2] = {
            AscendC::LocalTensor<float>(AscendC::TPosition::A1, 0, L1A_BYTES / sizeof(float)),
            AscendC::LocalTensor<float>(AscendC::TPosition::A1, L1A_BYTES, L1A_BYTES / sizeof(float))};
        AscendC::LocalTensor<float> l1bList[1] = {
            AscendC::LocalTensor<float>(AscendC::TPosition::B1, 2 * L1A_BYTES, L1B_BYTES / sizeof(float))};
        AscendC::LocalTensor<float> l0aList[2] = {
            AscendC::LocalTensor<float>(AscendC::TPosition::A2, 0, L0A_BYTES / sizeof(float)),
            AscendC::LocalTensor<float>(AscendC::TPosition::A2, L0A_BYTES, L0A_BYTES / sizeof(float))};
        AscendC::LocalTensor<float> l0bList[2] = {
            AscendC::LocalTensor<float>(AscendC::TPosition::B2, 0, L0B_BYTES / sizeof(float)),
            AscendC::LocalTensor<float>(AscendC::TPosition::B2, L0B_BYTES, L0B_BYTES / sizeof(float))};
        AscendC::LocalTensor<float> l0cList[2] = {
            AscendC::LocalTensor<float>(AscendC::TPosition::CO1, 0, L0C_BYTES / sizeof(float)),
            AscendC::LocalTensor<float>(AscendC::TPosition::CO1, L0C_BYTES, L0C_BYTES / sizeof(float))};
        // 事件号:L1A=0/1、L1B=2;L0A=0/1、L0B=2/3;L0C=0/1(随 stage 轮换;各 HardEvent 对独立)
        constexpr uint32_t l1AEvent[2] = {0, 1};
        constexpr uint32_t l1BEvent = 2;
        constexpr uint32_t l0AEvent[2] = {0, 1};
        constexpr uint32_t l0BEvent[2] = {2, 3};
        constexpr uint32_t l0CEvent[2] = {0, 1};
        uint32_t l1AListId = 0, l0AListId = 0, l0BListId = 0, l0CListId = 0;
        bool wLoaded = false;
        // 预置各 stage 首轮可用(同 BlockMmadTla 构造器)
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEvent[0]);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEvent[1]);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEvent);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEvent[0]);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEvent[1]);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEvent[0]);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEvent[1]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(l0CEvent[0]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(l0CEvent[1]);
        AscendC::LocalTensor<float> ubC(AscendC::TPosition::VECOUT, 0, static_cast<uint32_t>(fftN * nDim));

        for (int64_t li = 0; li < matCount; ++li) {
            const uint32_t owner = static_cast<uint32_t>(li & 1);
            if (li >= 2) {
                AscendC::CrossCoreWaitFlag<SYNC_MODE, PIPE_FIX>(SYNC_UB_FREE[owner]);
            }
            const int64_t m = matStart + li;
            // C 张量跨满瓦片 [fftN, nDim],分块锚点行 row0(example 全瓦片锚点同款)
            auto layoutC = tla::MakeLayout<float, layout::RowMajor>(static_cast<uint32_t>(fftN),
                                                                    static_cast<uint32_t>(nDim));
            auto tensorC = tla::MakeTensor(ubC, layoutC, Arch::PositionUB{});

            for (int64_t row0 = 0; row0 < fftN; row0 += MTILE) {
                const int32_t mt = static_cast<int32_t>((fftN - row0 < MTILE) ? (fftN - row0) : MTILE);
                GlobalTensor<float> gmA_tensor;
                gmA_tensor.SetGlobalBuffer((__gm__ float*)(input) + (m * fftN + row0) * kDim);
                GlobalTensor<float> gmW_tensor;
                gmW_tensor.SetGlobalBuffer((__gm__ float*)(wGm));
                auto layoutA = tla::MakeLayout<float, layout::RowMajor>(static_cast<uint32_t>(mt),
                                                                        static_cast<uint32_t>(kDim));
                auto layoutW = tla::MakeLayout<float, layout::RowMajor>(static_cast<uint32_t>(kDim),
                                                                        static_cast<uint32_t>(nDim));
                auto tensorA = tla::MakeTensor(gmA_tensor, layoutA, Arch::PositionGM{});
                auto tensorW = tla::MakeTensor(gmW_tensor, layoutW, Arch::PositionGM{});
                auto tensorBlockC = GetTile(tensorC, tla::MakeCoord(static_cast<uint32_t>(row0), 0u),
                                            tla::MakeShape(static_cast<uint32_t>(mt), static_cast<uint32_t>(nDim)));
                const uint32_t mtU = static_cast<uint32_t>(mt);
                const uint32_t nDimU = static_cast<uint32_t>(nDim);
                const uint32_t kDimU = static_cast<uint32_t>(kDim);
                // GM→L1:A 当前块(仅等 L1A 空闲=上上块读毕,与本块/上一块的算与搬并行;
                // kDim≤128 由 tiling 准入保证,单 L1 段直装)
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEvent[l1AListId]);
                {
                    auto tensorL1A = tla::MakeTensor(l1aList[l1AListId], HYB_L1A_LAYOUT, Arch::PositionL1{});
                    auto tileA = GetTile(tensorA, tla::MakeCoord(0u, 0u), tla::MakeShape(mtU, kDimU));
                    Gemm::Tile::TileCopyTla<ArchTag, decltype(tileA), HybridTensorL1A> copyGmToL1A;
                    copyGmToL1A(tensorL1A, tileA);
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEvent[l1AListId]);
                // GM→L1:W 全程恒定,首块装载后常驻(旗标循环保持,同 catlass resident 语义)
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEvent);
                if (!wLoaded) {
                    auto tensorL1B = tla::MakeTensor(l1bList[0], HYB_L1B_LAYOUT, Arch::PositionL1{});
                    auto tileW = GetTile(tensorW, tla::MakeCoord(0u, 0u), tla::MakeShape(kDimU, nDimU));
                    Gemm::Tile::TileCopyTla<ArchTag, decltype(tileW), HybridTensorL1B> copyGmToL1B;
                    copyGmToL1B(tensorL1B, tileW);
                    wLoaded = true;
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEvent);
                // L0C 本块 stage:等其上上轮 Fixpipe 消费完(2 级轮换,不与本块串行)
                AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(l0CEvent[l0CListId]);
                auto tensorL0C = tla::MakeTensor(l0cList[l0CListId], tla::MakeLayoutL0C(mtU, nDimU),
                                                 Arch::PositionL0C{});
                bool initC = true;
                const uint32_t kL0Loop = (kDimU + HYB_L0_K - 1) / HYB_L0_K;
                for (uint32_t kL0 = 0; kL0 < kL0Loop; ++kL0) {
                    const uint32_t kAct = (kDimU - kL0 * HYB_L0_K < HYB_L0_K) ? kDimU - kL0 * HYB_L0_K : HYB_L0_K;
                    // A:L1→L0A(2 级轮换,可与上一 k 块的 Mmad 重叠)
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEvent[l0AListId]);
                    if (kL0 == 0) {
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEvent[l1AListId]);
                    }
                    {
                        auto layoutInL0A = tla::MakeLayout<float, HybridTagL0A>(mtU, kAct);
                        auto tensorL0A = tla::MakeTensor(l0aList[l0AListId], layoutInL0A, Arch::PositionL0A{});
                        auto tensorL1A = tla::MakeTensor(l1aList[l1AListId], HYB_L1A_LAYOUT, Arch::PositionL1{});
                        auto tileL1A = GetTile(tensorL1A, tla::MakeCoord(0u, kL0 * HYB_L0_K),
                                               tla::MakeShape(mtU, kAct));
                        Gemm::Tile::TileCopyTla<ArchTag, HybridTensorL1A, HybridTensorL0A> copyL1ToL0A;
                        copyL1ToL0A(tensorL0A, tileL1A);
                    }
                    if (kL0 == kL0Loop - 1) {
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEvent[l1AListId]);
                    }
                    // B:L1→L0B(2 级轮换)
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEvent[l0BListId]);
                    if (kL0 == 0) {
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEvent);
                    }
                    {
                        auto layoutInL0B = tla::MakeLayout<float, layout::nZ>(kAct, nDimU);
                        auto tensorL0B = tla::MakeTensor(l0bList[l0BListId], layoutInL0B, Arch::PositionL0B{});
                        auto tensorL1B = tla::MakeTensor(l1bList[0], HYB_L1B_LAYOUT, Arch::PositionL1{});
                        auto tileL1B = GetTile(tensorL1B, tla::MakeCoord(kL0 * HYB_L0_K, 0),
                                               tla::MakeShape(kAct, nDimU));
                        Gemm::Tile::TileCopyTla<ArchTag, HybridTensorL1B, HybridTensorL0B> copyL1ToL0B;
                        copyL1ToL0B(tensorL0B, tileL1B);
                    }
                    if (kL0 == kL0Loop - 1) {
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEvent);
                    }
                    // 装载完成序(MTE1→M 自配对,借本块 L0C 事件号)后 Mmad 累加
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(l0CEvent[l0CListId]);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(l0CEvent[l0CListId]);
                    {
                        AscendC::MmadParams mmadParams;
                        mmadParams.m = mtU;
                        mmadParams.n = nDimU;
                        mmadParams.k = kAct;
                        mmadParams.unitFlag = 0;
                        mmadParams.cmatrixSource = false;
                        mmadParams.cmatrixInitVal = initC;
                        mmadParams.disableGemv = true;
                        AscendC::Mmad(l0cList[l0CListId], l0aList[l0AListId], l0bList[l0BListId], mmadParams);
                    }
                    initC = false;
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEvent[l0BListId]);
                    l0BListId = (l0BListId + 1 < 2) ? l0BListId + 1 : 0;
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEvent[l0AListId]);
                    l0AListId = (l0AListId + 1 < 2) ? l0AListId + 1 : 0;
                }
                // L0C→UB 手工 Fixpipe(与下一块的装载/Mmad 重叠;subBlockId 路由 owner AIV)
                AscendC::SetFlag<AscendC::HardEvent::M_FIX>(l0CEvent[l0CListId]);
                AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(l0CEvent[l0CListId]);
                HybridCopyL0CToUbManual<decltype(tensorL0C), decltype(tensorBlockC)> copyL0CToUb;
                copyL0CToUb(tensorBlockC, tensorL0C, owner != 0, 0);
                AscendC::SetFlag<AscendC::HardEvent::FIX_M>(l0CEvent[l0CListId]);
                l0CListId = (l0CListId + 1 < 2) ? l0CListId + 1 : 0;
                l1AListId = (l1AListId + 1 < 2) ? l1AListId + 1 : 0;
            }
            AscendC::CrossCoreSetFlag<SYNC_MODE, PIPE_FIX>(SYNC_GEMM_DONE[owner]);
        }
        AscendC::PipeBarrier<PIPE_FIX>();
        return;
    }

    if ASCEND_IS_AIV {
        // AIV:Stage C——融合 N 变换直吃 UB 瓦片(终态,example 同构):
        // 等 GEMM_DONE → radix-20×25 列 FFT + 数字反转散射直写 GM 终态输出 → 释放 bank。
        // 旗标配平:最后一个 owned 矩阵不发 UB_FREE(每轮发射 set/wait 逐 owner 严格相等
        // 防跨发射陈粮 set 被 wait 误食;冒烟坑①)
        const uint32_t subIdx = AscendC::GetSubBlockIdx();
        // 静态视图:瓦片 [0, 208000)(对齐 AIC 的静态 VECOUT 写,偏移 0 硬约束)
        // tw 驻 VECCALC 静态视窗 offset 212096(VECOUT 静态映射 208000B 以上不可读,
        // VECCALC 同偏移可读,装载见下)
        AscendC::LocalTensor<float> ubTile(AscendC::TPosition::VECOUT, 0, TILE_FLOATS);
        __ubuf__ float* tileAddr = (__ubuf__ float*)ubTile.GetPhyAddr();

        // tw 表静态 VECCALC 视窗装载(offset 212096:瓦片 208000 + fixpipe 尾部越界缓冲 4KB 之上;
        // TPipe 动态建池的每发射建立开销大于其收益,故用零建立的静态视窗)
        const int64_t twGmOff = kDim * nDim + (td->isInverse != 0 ? TW_FLOATS : 0);
        AscendC::LocalTensor<float> twLt(AscendC::TPosition::VECCALC, 212096, TW_FLOATS);
        AscendC::GlobalTensor<float> gmTw;
        gmTw.SetGlobalBuffer(wGm + twGmOff, TW_FLOATS);
        AscendC::DataCopy(twLt, gmTw, TW_FLOATS);
        __ubuf__ float* twUb = (__ubuf__ float*)twLt.GetPhyAddr();
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);

        const int64_t owned = (matCount - subIdx + 1) / 2;
        int64_t drained = 0;
        for (int64_t li = subIdx; li < matCount; li += 2) {
            AscendC::CrossCoreWaitFlag<SYNC_MODE, PIPE_V>(AIV_WAIT_DONE);
            // tw 已在循环前一次装载进 UB(VECCALC 静态视窗 212096,见循环前)
            const int64_t m = matStart + li;
            __gm__ float* gmOutM = output + m * GM_MAT_FLOATS;
            {
                AscendC::PipeBarrier<PIPE_V>();
                // 方向固定按发射:符号实例化在 SIMT 体外交错(蝴蝶内无运行时分支)
                // 级 A/级 B 合并为单次 vf 调用
                if (td->isInverse == 0) {
                    asc_vf_call<hybrid_stage_ab_impl<1>>(dim3(SIMT_THREADS), tileAddr, twUb, gmOutM);
                } else {
                    asc_vf_call<hybrid_stage_ab_impl<-1>>(dim3(SIMT_THREADS), tileAddr, twUb, gmOutM);
                }
                AscendC::DataSyncBarrier<MemDsbT::UB>();
                // SIMT(V 管线)读瓦片先于跨核 FREE 旗标:V 沉到 MTE3 阻塞事件(example 同款)
                SetFlag<HardEvent::V_MTE3>(0);
                WaitFlag<HardEvent::V_MTE3>(0);
            }
            ++drained;
            if (drained < owned) {
                // FREE 置走 V 管线(配平纪律:最后一个 owned 不置)
                AscendC::CrossCoreSetFlag<SYNC_MODE, PIPE_V>(AIV_SET_FREE);
            }
        }
        AscendC::PipeBarrier<PIPE_MTE3>();
    }
}
