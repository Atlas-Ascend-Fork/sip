#define SIP_FFT_REGBASE_OPTIMIZED 1
#include "regbase_small_impl.h"
#include "../tiling/fft_regbase_tiling_data.h"

#ifndef TILING_KEY_VAR
#error "MKI must compile each C2C RegBase Optimized specialization with TILING_KEY_VAR"
#endif
#ifndef TILING_KEY_IS
#define TILING_KEY_IS(key) (TILING_KEY_VAR == (key))
#endif

static_assert(sizeof(AsdSip::FftC2CRegBaseTilingData) == sizeof(FftC2CRegBaseSmallTilingData));

namespace {
template <int32_t N, int32_t TilePoints, FftC2CRegBaseSmallVariant Variant, bool DoubleBuffer, bool Inverse>
__aicore__ inline void RunC2CRegBaseOptimized(__gm__ float* input, __gm__ float* coeff, __gm__ float* output,
                                              __gm__ uint8_t* tiling)
{
    const int64_t batch = LoadBatch<N, TilePoints>(tiling);
    if (batch <= 0)
        return;
    if constexpr (DoubleBuffer) {
        RunDoubleBufferedDirectPrefetch<N, TilePoints, Variant, Inverse>(input, coeff, output, batch);
    } else {
        RunSingleBuffered<N, TilePoints, Variant, Inverse>(input, coeff, output, batch);
    }
}
} // namespace

// Same two-input/one-output/unused-workspace/16-byte-tiling ABI as the original.
extern "C" __global__ __vector__ void fft_c2c_regbase_optimized(__gm__ float* input, __gm__ float* coeff,
                                                                __gm__ float* output, __gm__ uint8_t* workspace,
                                                                __gm__ uint8_t* tiling)
{
    (void)workspace;
    AscendC::InitSocState();
    if constexpr (TILING_KEY_IS(2000512)) {
        RunC2CRegBaseOptimized<32, 256, FftC2CRegBaseSmallVariant::FusedRegisterDirect, false, false>(input, coeff,
                                                                                                      output, tiling);
    }
    if constexpr (TILING_KEY_IS(2000514)) {
        RunC2CRegBaseOptimized<32, 256, FftC2CRegBaseSmallVariant::FusedRegisterDirectDoubleBuffer, true, false>(
            input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2001024)) {
        RunC2CRegBaseOptimized<64, 256, FftC2CRegBaseSmallVariant::FusedRegisterDirect, false, false>(input, coeff,
                                                                                                      output, tiling);
    }
    if constexpr (TILING_KEY_IS(2001026)) {
        RunC2CRegBaseOptimized<64, 256, FftC2CRegBaseSmallVariant::FusedRegisterDirectDoubleBuffer, true, false>(
            input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2002048)) {
        RunC2CRegBaseOptimized<128, 256, FftC2CRegBaseSmallVariant::FusedRegisterLazyContiguousDirectDoubleBuffer,
                               false, false>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2002050)) {
        RunC2CRegBaseOptimized<128, 256, FftC2CRegBaseSmallVariant::FusedRegisterLazyContiguousDirectDoubleBuffer, true,
                               false>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2004096)) {
        RunC2CRegBaseOptimized<256, 256, FftC2CRegBaseSmallVariant::FusedRegisterLazyContiguousDirectDoubleBuffer,
                               false, false>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2004098)) {
        RunC2CRegBaseOptimized<256, 256, FftC2CRegBaseSmallVariant::FusedRegisterLazyContiguousDirectDoubleBuffer, true,
                               false>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2008192)) {
        RunC2CRegBaseOptimized<512, 1024, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirect, false, false>(
            input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2008193)) {
        RunC2CRegBaseOptimized<512, 1024, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirect, false, true>(
            input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2008194)) {
        RunC2CRegBaseOptimized<512, 1024, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirectDoubleBuffer, true,
                               false>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2008195)) {
        RunC2CRegBaseOptimized<512, 1024, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirectDoubleBuffer, true, true>(
            input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2016384)) {
        RunC2CRegBaseOptimized<1024, 1024, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirect, false, false>(
            input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2016385)) {
        RunC2CRegBaseOptimized<1024, 1024, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirect, false, true>(
            input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2016386)) {
        RunC2CRegBaseOptimized<1024, 1024, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirectDoubleBuffer, true,
                               false>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2016387)) {
        RunC2CRegBaseOptimized<1024, 1024, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirectDoubleBuffer, true,
                               true>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2032768)) {
        RunC2CRegBaseOptimized<2048, 2048, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirect, false, false>(
            input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2032769)) {
        RunC2CRegBaseOptimized<2048, 2048, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirect, false, true>(
            input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2032770)) {
        RunC2CRegBaseOptimized<2048, 2048, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirectDoubleBuffer, true,
                               false>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2032771)) {
        RunC2CRegBaseOptimized<2048, 2048, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirectDoubleBuffer, true,
                               true>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2065536)) {
        RunC2CRegBaseOptimized<4096, 4096, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirect, false, false>(
            input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2065537)) {
        RunC2CRegBaseOptimized<4096, 4096, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirect, false, true>(
            input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2065538)) {
        RunC2CRegBaseOptimized<4096, 4096, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirectDoubleBuffer, true,
                               false>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2065539)) {
        RunC2CRegBaseOptimized<4096, 4096, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirectDoubleBuffer, true,
                               true>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2131072)) {
        RunC2CRegBaseOptimized<8192, 8192, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirect, false, false>(
            input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2131073)) {
        RunC2CRegBaseOptimized<8192, 8192, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirect, false, true>(
            input, coeff, output, tiling);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}
