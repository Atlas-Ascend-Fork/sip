#include "transpose_impl.h"
#ifndef TILING_KEY_IS
#define TILING_KEY_IS(key) (TILING_KEY_VAR == (key))
#endif
extern "C" __global__ __vector__ void fft_transpose(__gm__ float* input, __gm__ float* output,
                                                    __gm__ uint8_t* workspace, __gm__ uint8_t* tiling)
{
    (void)workspace;
    AscendC::InitSocState();
    const auto* raw = reinterpret_cast<__gm__ FftTransposeTiling*>(tiling);
    const FftTransposeTiling p{raw->batch, raw->rows, raw->cols};
    if constexpr (TILING_KEY_IS(1)) {
        FftTranspose::Run<64, 2>(input, output, p);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}
