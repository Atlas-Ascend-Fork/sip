#include "row_fft.h"
#include "cube_tail_tiles.h"
#ifndef TILING_KEY_IS
#define TILING_KEY_IS(key) (TILING_KEY_VAR == (key))
#endif

namespace {
constexpr int DEPTH = 2;
constexpr int maxRowFloats = 8192; // 32 * 127 complex values, rounded to 512 floats.
constexpr AscendC::FixpipeConfig kDnUb = {AscendC::CO2Layout::COLUMN_MAJOR, true};
#define SET_FLAG(a, b, e) AscendC::SetFlag<AscendC::HardEvent::a##_##b>(e)
#define WAIT_FLAG(a, b, e) AscendC::WaitFlag<AscendC::HardEvent::a##_##b>(e)

template <int P>
__simt_vf__ __launch_bounds__(256) inline void ClearPadding(__ubuf__ float* packed, int K)
{
    constexpr int matrixFloats = 64 * P;
    for (int i = threadIdx.x; i < 64 * (P - K); i += 256) {
        int m = i / (P - K), k = K + i % (P - K);
        int pos = (m / 16) * (16 * P) + (k / 8) * 128 + (m % 16) * 8 + k % 8;
        packed[pos] = 0.f;
        packed[matrixFloats + pos] = 0.f;
    }
}

template <int P>
__simt_vf__ __launch_bounds__(256) inline void Pack(__ubuf__ float* src, __ubuf__ float* roots, __ubuf__ float* packed,
                                                    __ubuf__ float* auxiliary, int a, int r)
{
    constexpr int matrixFloats = 64 * P;
    int h = r / 2;
    for (int i = threadIdx.x; i < a * h; i += 256) {
        int j = i % 32, p = i / 32 + 1;
        int l = 2 * (p * a + j), m = 2 * ((r - p) * a + j);
        int w = 2 * p * j, v = 2 * (r - p) * j;
        float lr = src[l] * roots[w] - src[l + 1] * roots[w + 1];
        float li = src[l] * roots[w + 1] + src[l + 1] * roots[w];
        float mr = src[m] * roots[v] - src[m + 1] * roots[v + 1];
        float mi = src[m] * roots[v + 1] + src[m + 1] * roots[v];
        int k = p - 1;
        int pos = (j / 16) * (16 * P) + (k / 8) * 128 + (j % 16) * 8 + k % 8;
        packed[pos] = lr + mr;
        packed[pos + matrixFloats / 2] = li + mi;
        packed[pos + matrixFloats] = lr - mr;
        packed[pos + 3 * matrixFloats / 2] = li - mi;
    }
    for (int j = threadIdx.x; j < a; j += 256) {
        auxiliary[j] = src[2 * j];
        auxiliary[a + j] = src[2 * j + 1];
    }
}

template <int P>
__simt_vf__ __launch_bounds__(256) inline void Restore(__ubuf__ float* e, __ubuf__ float* o, __ubuf__ float* d,
                                                       __ubuf__ float* y, int R)
{
    const int K = R / 2;
    for (int i = threadIdx.x; i < 32 * K; i += 256) {
        int j = i % 32, q = i / 32, k = 2 * ((q + 1) * 32 + j), l = 2 * ((R - 1 - q) * 32 + j);
        int pos = q * 64 + j;
        float re = d[j] + e[pos], im = d[32 + j] + e[pos + 32];
        y[k] = re + o[pos + 32];
        y[k + 1] = im - o[pos];
        y[l] = re - o[pos + 32];
        y[l + 1] = im + o[pos];
    }
    if (threadIdx.x < 32) {
        int j = threadIdx.x;
        y[2 * j] = d[j] + e[K * 64 + j];
        y[2 * j + 1] = d[32 + j] + e[K * 64 + 32 + j];
    }
}
template <int P>
__aicore__ inline void Cube(__gm__ float* weights, int batch, int resultOffset)
{
    constexpr int matrixFloats = 64 * P;
    using namespace AscendC;
    GlobalTensor<float> coeff;
    coeff.SetGlobalBuffer(weights);
    AscendC::LocalTensor<float> b1(AscendC::TPosition::B1, 128 * 1024, 4096);
    AscendC::LocalTensor<float> b0(AscendC::TPosition::B2, 0, 8192);
    AscendC::LocalTensor<float> a0(AscendC::TPosition::A2, 0, 2 * 4096);
    AscendC::SetLoadDataPaddingValue<float>(0);
    AscendC::SetAtomicNone();
    DataCopy(b1, coeff, Nd2NzParams(P / 16, 16, P, 16 * P, P, 16, 1, 16 * P));
    SET_FLAG(MTE2, MTE1, EVENT_ID2);
    WAIT_FLAG(MTE2, MTE1, EVENT_ID2);
    for (int i = 0; i < P / 16; ++i)
        AscendC::LoadDataWithTranspose(
            b0[i * 128], b1[i * 256],
            AscendC::LoadData2dTransposeParams(0, P / 16, P / 16, P / 8 - 1, P / 16 - 1, inc));
    SET_FLAG(MTE1, M, EVENT_ID2);
    WAIT_FLAG(MTE1, M, EVENT_ID2);

    AscendC::PipeBarrier<PIPE_ALL>();
    DataCopy(b1, coeff[P * P], Nd2NzParams(P / 16, 16, P, 16 * P, P, 16, 1, 16 * P));
    SET_FLAG(MTE2, MTE1, EVENT_ID2);
    WAIT_FLAG(MTE2, MTE1, EVENT_ID2);
    for (int i = 0; i < P / 16; i++)
        LoadDataWithTranspose(b0[4096 + i * 128], b1[i * 256],
                              LoadData2dTransposeParams(0, P / 16, P / 16, P / 8 - 1, P / 16 - 1, inc));
    PipeBarrier<PIPE_ALL>();
    LocalTensor<float> c(TPosition::CO1, 0, 8192);
    int ordinal = 0;
    for (int row = 2 * GetBlockIdx(); row < batch; row += 2 * GetBlockNum(), ++ordinal) {
        int slot = ordinal % DEPTH;
        CrossCoreWaitFlag<2, PIPE_MTE1>(2 + slot);
        for (int stage = 0; stage < 2; stage++) {
            LocalTensor<float> a1(TPosition::A1, (slot * 4 + stage * 2) * matrixFloats * sizeof(float),
                                  2 * matrixFloats);
            for (int i = 0; i < 8; i++)
                LoadData(a0[i * 128], a1[i * 16 * P], LoadData2dParams(0, P / 8, 1, 0, 7, false, inc));
            SET_FLAG(MTE1, M, EVENT_ID0);
            WAIT_FLAG(MTE1, M, EVENT_ID0);
            Mmad(c, a0, b0[stage * 4096], MmadParams(128, P, P, 0, false, true));
            SET_FLAG(M, FIX, EVENT_ID0);
            WAIT_FLAG(M, FIX, EVENT_ID0);
            LocalTensor<float> receive(
                TPosition::VECOUT, (resultOffset + (2 * slot + stage) * matrixFloats) * sizeof(float), matrixFloats);
            AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::COLUMN_MAJOR> fp;
            fp.nSize = P;
            fp.mSize = 64;
            fp.srcStride = 128;
            fp.dstStride = 64;
            fp.quantPre = QuantMode_t::NoQuant;
            fp.params.dnNum = 1;
            fp.params.srcNzC0Stride = 1;
            fp.params.srcNzMatrixStride = 0;
            fp.params.dstDnMatrixStride = 0;
            fp.subBlockId = 0;
            AscendC::Fixpipe<float, float, kDnUb>(receive, c, fp);
            fp.subBlockId = 1;
            AscendC::Fixpipe<float, float, kDnUb>(receive, c[64 * 16], fp);

            PipeBarrier<PIPE_ALL>();
        }
        CrossCoreSetFlag<2, PIPE_FIX>(8 + slot);
    }
}
template <int P>
__aicore__ inline void Vector(__gm__ float* xg, __gm__ float* wg, __gm__ float* yg, int batch, int R, bool inverse)
{
    constexpr int matrixFloats = 64 * P;
    const int N = 32 * R, rowFloats = ((2 * N + 511) / 512) * 512;
    const int auxiliaryOffset = 3 * rowFloats + 2 * matrixFloats, resultOffset = auxiliaryOffset + 128;
    using namespace AscendC;
    constexpr int arenaFloats = 3 * maxRowFloats + 6 * matrixFloats + 128;
    static_assert(arenaFloats <= 212 * 1024 / sizeof(float));
    __ubuf__ float arena[arenaFloats];
    auto* roots = arena;
    auto* x = roots + rowFloats;
    auto* y = x + rowFloats;
    auto* packed = y + rowFloats;
    const int sub = GetSubBlockIdx(), first = 2 * (GetBlockIdx() / 2) + sub, step = 2 * GetBlockNum();
    // Both AIVs must participate in every handshake, including the final unpaired row.
    // Its partner reads the last valid row but suppresses its GM store.
    const int count = (batch + step - 1 - (first - sub)) / step;
    asc_copy_gm2ub_align(roots, wg, 1, N * 8, 0, 0, false, 0, 0, 0);
    asc_vf_call<ClearPadding<P>>(dim3(256), packed, R / 2);
    PipeBarrier<PIPE_ALL>();
    // Produce before consuming the previous row, then drain the last live slot.
    for (int i = 0; i < count + DEPTH - 1; ++i) {
        if (i < count) {
            const int slot = i % DEPTH, row = first + i * step;
            auto* aux = arena + auxiliaryOffset + slot * 64;
            asc_copy_gm2ub_align(x, xg + 2 * N * (row < batch ? row : batch - 1), 1, N * 8, 0, 0, false, 0, 0, 0);
            PipeBarrier<PIPE_ALL>();
            fft_mixed::TilePrefix(x, y, roots, N, N, 5, inverse, 1, 2 * N);
            PipeBarrier<PIPE_ALL>();
            asc_vf_call<Pack<P>>(dim3(256), y, roots, packed, aux, 32, R);
            SET_FLAG(V, MTE3, EVENT_ID0);
            WAIT_FLAG(V, MTE3, EVENT_ID0);
            for (int stage = 0; stage < 2; ++stage) {
                LocalTensor<float> l1(TPosition::A1, (slot * 4 + stage * 2 + sub) * matrixFloats * sizeof(float),
                                      matrixFloats);
                asc_copy_ub2l1((__cbuf__ float*)l1.GetPhyAddr(), packed + stage * matrixFloats,
                               matrixFloats * sizeof(float));
            }
            CrossCoreSetFlag<2, PIPE_MTE3>(2 + slot);
            PipeBarrier<PIPE_ALL>();
        }
        const int prev = i - (DEPTH - 1);
        if (prev >= 0) {
            const int slot = prev % DEPTH, row = first + prev * step;
            CrossCoreWaitFlag<2, PIPE_V>(8 + slot);
            auto* even = arena + resultOffset + 2 * slot * matrixFloats;
            asc_vf_call<Restore<P>>(dim3(256), even, even + matrixFloats, arena + auxiliaryOffset + slot * 64, x, R);
            PipeBarrier<PIPE_ALL>();
            if (row < batch)
                asc_copy_ub2gm_align(yg + 2 * N * row, x, 1, N * 8, 0, 0, 0);
            PipeBarrier<PIPE_ALL>();
        }
    }
}
template <int P>
__aicore__ inline void Run(__gm__ float* x, __gm__ float* roots, __gm__ float* y, int n, int rows, bool inverse)
{
    const int rowFloats = ((2 * n + 511) / 512) * 512;
    if ASCEND_IS_AIC {
        Cube<P>(roots + 2 * n, rows, 3 * rowFloats + 2 * 64 * P + 128);
    }
    if ASCEND_IS_AIV {
        Vector<P>(x, roots, y, rows, n / 32, inverse);
    }
}
} // namespace
extern "C" __global__ __mix__(1, 2) void fft_cube_tail(__gm__ float* x, __gm__ float* roots, __gm__ float* y,
                                                       __gm__ uint8_t* workspace, __gm__ uint8_t* tiling)
{
    AscendC::InitSocState();
    auto* t = reinterpret_cast<__gm__ AsdSip::OpParam::MixedCommonTiling*>(tiling);
    if constexpr (TILING_KEY_IS(16))
        Run<16>(x, roots, y, t->n, t->rows, t->inverse);
    if constexpr (TILING_KEY_IS(32))
        Run<32>(x, roots, y, t->n, t->rows, t->inverse);
    if constexpr (TILING_KEY_IS(48))
        Run<48>(x, roots, y, t->n, t->rows, t->inverse);
    if constexpr (TILING_KEY_IS(64))
        Run<64>(x, roots, y, t->n, t->rows, t->inverse);
    if constexpr (TILING_KEY_IS(1116))
        fft_cube_tiles::Run<8, 16>(x, roots, y, t);
    if constexpr (TILING_KEY_IS(1132))
        fft_cube_tiles::Run<8, 32>(x, roots, y, t);
    if constexpr (TILING_KEY_IS(1148))
        fft_cube_tiles::Run<8, 48>(x, roots, y, t);
    if constexpr (TILING_KEY_IS(1164))
        fft_cube_tiles::Run<8, 64>(x, roots, y, t);
    if constexpr (TILING_KEY_IS(1216))
        fft_cube_tiles::Run<16, 16>(x, roots, y, t);
    if constexpr (TILING_KEY_IS(1232))
        fft_cube_tiles::Run<16, 32>(x, roots, y, t);
    if constexpr (TILING_KEY_IS(1248))
        fft_cube_tiles::Run<16, 48>(x, roots, y, t);
    if constexpr (TILING_KEY_IS(1264))
        fft_cube_tiles::Run<16, 64>(x, roots, y, t);
    if constexpr (TILING_KEY_IS(1416))
        fft_cube_tiles::Run<32, 16>(x, roots, y, t);
    if constexpr (TILING_KEY_IS(1432))
        fft_cube_tiles::Run<32, 32>(x, roots, y, t);
    if constexpr (TILING_KEY_IS(1448))
        fft_cube_tiles::Run<32, 48>(x, roots, y, t);
    if constexpr (TILING_KEY_IS(1464))
        fft_cube_tiles::Run<32, 64>(x, roots, y, t);
    AscendC::PipeBarrier<PIPE_ALL>();
}
